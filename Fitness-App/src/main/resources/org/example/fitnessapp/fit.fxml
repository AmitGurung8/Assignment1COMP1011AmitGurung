<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.fitnessapp.Controllers.Fit">
   <children>
      <BorderPane prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
         <top>
            <Label styleClass="header-label" text="Fitness Tracker" BorderPane.alignment="CENTER" />
         </top>
         <center>
            <BarChart fx:id="BarChartFitness" prefHeight="350.0" prefWidth="600.0">
               <xAxis>
                  <CategoryAxis fx:id="Namee" />
               </xAxis>
               <yAxis>
                  <NumberAxis fx:id="CaloriesBurned" />
               </yAxis>
            </BarChart>
         </center>
         <bottom>
            <HBox alignment="CENTER_RIGHT" prefHeight="75.0" prefWidth="800.0" BorderPane.alignment="CENTER">
               <children>
                  <RadioButton fx:id="Pushe" onAction="#PushAction" styleClass="radio-button" text="Push" />
                  <RadioButton fx:id="Pulle" onAction="#PullAction" styleClass="radio-button" text="Pull" />
                  <RadioButton fx:id="Legse" onAction="#LegsAction" styleClass="radio-button" text="Legs">
                     <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                     </padding></RadioButton>
                  <Button fx:id="TableView" onAction="#TableView" prefHeight="46.0" prefWidth="109.0" styleClass="action-button" text="Table" />
               </children>
               <BorderPane.margin>
                  <Insets top="10.0" />
               </BorderPane.margin>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </HBox>
         </bottom>
      </BorderPane>
   </children>
   <stylesheets>
      <URL value="@styles.css" />
      <URL value="@../../../../../target/classes/org/example/fitnessapp/styles.css" />
   </stylesheets>
</VBox>
